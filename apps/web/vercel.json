{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "app/api/cron/exchange-reconciliation/route.ts": {
      "regions": ["gru1"]
    },
    "app/api/coinops-testnet/diagnostic/route.ts": {
      "regions": ["gru1"]
    },
    "app/automacao/page.tsx": {
      "regions": ["gru1"]
    },
    "app/api/cron/testnet-execution/route.ts": {
      "regions": ["gru1"],
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/market-regime",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/exchange-reconciliation",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/testnet-execution",
      "schedule": "*/5 * * * *"
    }
  ]
}
