[Unit]
Description=CoinOps expired authentication nonce retention (no trading)
After=local-fs.target

[Service]
Type=oneshot
User=coinops-executor
Group=coinops-executor
ExecStart=/bin/bash /opt/coinops/maintenance/current/apps/live-executor/deploy/run-nonce-retention.sh
RuntimeDirectory=coinops-nonce-retention
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Nice=10
IOSchedulingClass=idle
# A legacy backlog may need many bounded batches. The same locked directory
# stream stays open between batches, avoiding starvation behind protected files.
TimeoutStartSec=1d
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=/etc/coinops
ReadOnlyPaths=/var/lib/coinops-live-executor
ReadWritePaths=/var/lib/coinops-live-executor/nonces /run/coinops-nonce-retention
StandardOutput=journal
StandardError=journal
